# Copy this file to .env and fill in your own backend values.
# Point these at the SAME backend as your web app so the app and site stay in sync.
# Every var must be prefixed EXPO_PUBLIC_ so Expo inlines it into the client bundle.

# API base = your deployed web app URL (e.g. https://your-studio.vercel.app)
EXPO_PUBLIC_API_BASE=

# Chat worker WebSocket URL (e.g. wss://your-chat.workers.dev)
EXPO_PUBLIC_CHAT_WS_URL=

# Cloudflare Stream customer/account subdomain code
EXPO_PUBLIC_CF_STREAM_CUSTOMER_CODE=
# Cloudflare Stream live input UID
EXPO_PUBLIC_CF_STREAM_LIVE_INPUT_UID=

# Stripe publishable key (pk_test_... or pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase web config (from your Firebase project settings > web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs (leave blank to disable Google sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
